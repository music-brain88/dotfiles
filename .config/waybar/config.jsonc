// waybar のバーの定義。出力の幅に合わせて 2 種類のバーを出す。
// モジュールの中身(format やスクリプト)は modules.jsonc にあり、両方のバーが include で共有する。
// Bar definitions for waybar: two bars, chosen by output width.
// Module bodies (formats, scripts) live in modules.jsonc, shared by both bars through include.
[
  // ---- 外部モニター用(フル) / external monitors (full) ----
  // 内蔵画面(eDP-1)以外の全部の出力に出す。内蔵画面の無い機械では、今までどおり全部の出力がこのバーになる。
  // Shown on every output except the internal panel (eDP-1); on machines without one, all outputs get this bar as before.
  {
    "output": "!eDP-1",
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,
    "margin-top": 6,
    "margin-bottom": 0,
    // 三島構成(#559): 中央島(workspaces計器盤)が常に視野中心にいるので、左右の島は
    // 端まで戻してよい。6pxはmargin-topと揃えた「浮き」の名残り。島スタイルはstyle.css側。
    // Three-island layout (#559): with the center island (workspaces gauge) pinned at the
    // visual center, the side islands can sit at the screen edges again. 6px matches
    // margin-top for the floating look; island styling lives in style.css.
    "margin-left": 6,
    "margin-right": 6,
    // 中央集約(#559 案A): 「読む」情報(workspaces計器盤)は視野中心、「見る」情報(時計・日付)は左端へ
    // Centralized layout (#559 plan A): information you READ (workspaces gauge) sits at the
    // visual center; information you GLANCE at (clock, date) goes to the far-left zone.
    "modules-left": [
      //"clock#date",
      "clock",
      "custom/weather",
      "custom/sun_moon",
      "custom/holiday",
    ],
    "modules-center": [
      "hyprland/workspaces",
      "hyprland/submap",
      "hyprland/window",
      "custom/bring",
    ],
    "modules-right": [
      "custom/media",
      "hyprland/language",
      "pulseaudio",
      "pulseaudio#microphone",
      "cpu",
      "memory",
      "network",
      "temperature",
      "backlight",
      "battery",
      "custom/power",
      "tray",
    ],
  },

  // ---- 内蔵画面用(コンパクト) / internal panel (compact) (#836) ----
  // ノート PC の内蔵画面は scale 1.5 で論理幅が 1280px しかなく、フルのバーだと右の島(約 840px)が
  // 中央の島に乗り上げる。三島構成は保ったまま、モジュールを持ち歩くときに要るものへ絞る。
  // 目安: 中央の島が左右に重ならない条件は「中央の島の幅の半分 < 640px - 広いほうの島の幅」。
  // 右の島を約 420px に収めてあるので、中央の島は約 420px まで使える。モジュールを足すときはこの式で確かめる。
  // The laptop panel is only 1280 logical px wide at scale 1.5, where the full bar's right island (~840px)
  // runs over the center island. Keep the three islands but trim the modules to what matters on the go.
  // Rule of thumb: the center island stays clear while "half its width < 640px - the wider side island".
  // The right island is kept near 420px, leaving ~420px for the center; check this before adding modules.
  {
    "output": "eDP-1",
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,
    "margin-top": 6,
    "margin-bottom": 0,
    "margin-left": 6,
    "margin-right": 6,
    "modules-left": [
      "clock",
      "custom/weather",
    ],
    "modules-center": [
      "hyprland/workspaces",
      "hyprland/submap",
    ],
    "modules-right": [
      "pulseaudio",
      "network",
      "backlight",
      "battery",
      "custom/power",
      "tray",
    ],
    // SSID を出すと 1 つで 190px ほど使うので、電波の強さだけにする。SSID はツールチップと右クリックで確かめられる。
    // The SSID alone takes ~190px, so show the signal strength only; the tooltip and right click still reveal it.
    "network": {
      "format-wifi": "\uf1eb {signalStrength}%", // nf-fa-wifi
      "format-ethernet": "\udb80\ude00", // nf-md-ethernet
      "tooltip-format-wifi": "{essid} ({signalStrength}%) {ifname} via {gwaddr}",
      "tooltip-format": "{ifname} via {gwaddr}",
      "format-linked": "\udb80\ude00 (No IP)",
      "format-disconnected": "⚠",
      "format-alt": "{ifname}: {ipaddr}/{cidr}",
      "on-click-right": "nm-connection-editor",
    },
  },
]
